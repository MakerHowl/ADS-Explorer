<Window x:Class="TwinCatVariableExplorer.Views.ExportJsonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Symbol als JSON exportieren" 
        Height="550" Width="750"
        MinHeight="400" MinWidth="550"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Symbol Selection -->
            <RowDefinition Height="*" />    <!-- JSON Preview -->
            <RowDefinition Height="Auto" /> <!-- Status & Actions -->
        </Grid.RowDefinitions>

        <!-- 1. Symbol Selection -->
        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Symbolpfad:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />

                <ComboBox Grid.Column="1" 
                          IsEditable="True" 
                          Text="{Binding SymbolPath, UpdateSourceTrigger=LostFocus}" 
                          ItemsSource="{Binding SuggestedPaths}" 
                          VerticalAlignment="Center" 
                          Padding="6,4" 
                          Margin="0,0,10,0"
                          ToolTip="Symbolpfad auswählen oder manuell eingeben (z. B. MAIN.stMachine)" />

                <Button Grid.Column="2" 
                        Command="{Binding RefreshPreviewCommand}" 
                        Content="Vorschau laden" 
                        Padding="12,5" 
                        FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- 2. JSON Preview -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="JSON-Vorschau:" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#495057" />

            <TextBox Grid.Row="1" 
                     Text="{Binding JsonPreview, Mode=OneWay}" 
                     IsReadOnly="True" 
                     FontFamily="Consolas, Cascadia Code, Courier New" 
                     FontSize="12" 
                     Background="#F8F9FA" 
                     BorderBrush="#CED4DA" 
                     VerticalScrollBarVisibility="Auto" 
                     HorizontalScrollBarVisibility="Auto" 
                     AcceptsReturn="True" 
                     TextWrapping="NoWrap" 
                     Padding="8" />
        </Grid>

        <!-- 3. Status & Actions -->
        <DockPanel Grid.Row="2" LastChildFill="False">
            <!-- Status Text -->
            <TextBlock DockPanel.Dock="Left" 
                       Text="{Binding StatusMessage}" 
                       VerticalAlignment="Center" 
                       Foreground="#495057" 
                       FontWeight="Medium" 
                       TextTrimming="CharacterEllipsis" 
                       MaxWidth="360" />

            <!-- Buttons -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding CopyToClipboardCommand}" 
                        IsEnabled="{Binding CanSave}" 
                        Content="In Zwischenablage kopieren" 
                        Padding="12,6" 
                        Margin="0,0,8,0" />

                <Button Command="{Binding SaveToFileCommand}" 
                        IsEnabled="{Binding CanSave}" 
                        Content="In Datei speichern..." 
                        FontWeight="Bold" 
                        Padding="14,6" 
                        Margin="0,0,8,0" />

                <Button Content="Schließen" 
                        IsCancel="True" 
                        Padding="12,6" 
                        Click="OnCloseClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
